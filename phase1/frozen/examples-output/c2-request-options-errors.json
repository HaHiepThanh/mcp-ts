  "steps": [
    {
      "step": "A. timeout 400 ms → times out",
      "method": "callTool(params, options)",
      "params": {
        "name": "export_transcripts",
        "arguments": {
          "batches": 8,
          "delayMs": 150
        },
        "options": {
          "timeout": 400
        }
      },
      "ok": false,
      "ms": 410,
      "error": {
        "name": "SdkError",
        "code": "REQUEST_TIMEOUT",
        "message": "Request timed out"
      }
    },
    {
      "step": "B. timeout 400 ms + resetTimeoutOnProgress → each update restarts the clock",
      "method": "callTool(params, options)",
      "params": {
        "name": "export_transcripts",
        "arguments": {
          "batches": 8,
          "delayMs": 150
        },
        "options": {
          "timeout": 400,
          "resetTimeoutOnProgress": true
        }
      },
      "ok": true,
      "ms": 1226,
      "result": {
        "text": "Exported 8 batches",
        "progressUpdates": 8
      }
    },
    {
      "step": "C. same + maxTotalTimeout 700 ms → hard cap wins",
      "method": "callTool(params, options)",
      "params": {
        "name": "export_transcripts",
        "arguments": {
          "batches": 8,
          "delayMs": 150
        },
        "options": {
          "timeout": 400,
          "resetTimeoutOnProgress": true,
          "maxTotalTimeout": 700
        }
      },
      "ok": false,
      "ms": 763,
      "error": {
        "name": "SdkError",
        "code": "REQUEST_TIMEOUT",
        "message": "Maximum total timeout exceeded"
      }
    },
    {
      "step": "D. default timeout (60 s) → completes",
