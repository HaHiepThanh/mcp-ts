  "ranAt": "2026-09-21T07:07:09.474Z",
  "steps": [
    {
      "step": "With onprogress → server sends notifications/progress",
      "method": "callTool",
      "params": {
        "name": "rank_students",
        "arguments": {
          "scope": "all",
          "top": 3
        },
        "options": {
          "onprogress": "fn"
        }
      },
      "ok": true,
      "ms": 9,
      "result": {
        "progressUpdates": [
          {
            "progress": 10,
            "total": 40,
            "message": "Scored 10/40 students"
          },
          {
            "progress": 20,
