{
  "example": "s6-logging-progress-cancel",
  "title": "S6 · Progress, logging and cancellation (ctx.mcpReq)",
  "sdkMethods": [
    "ctx.mcpReq.notify (progress)",
    "ctx.mcpReq.log",
