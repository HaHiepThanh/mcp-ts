# Copy thành file .env (đặt ở mcp-hocvu/ hoặc thư mục gốc seminar-emt/) rồi điền giá trị thật.
# KHÔNG commit, KHÔNG đưa lên Drive, KHÔNG chụp lên slide.

# Model 1 — Gemini (cloud). Tạo key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (tuỳ chọn) ghim tên model, để trống thì tự chọn bản Flash ổn định mới nhất
GEMINI_MODEL=

# Model 2 — Qwen qua Ollama (chạy trên máy)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
