{
    "id": "E1",
    "title": "LLM model",
    "kind": "llm",
    "base": "config/host.experiment.json",
    "scenarios": "all",
    "repeat": 2,
    "question": "Same MCP servers and scenarios — how much do accuracy and speed depend on the LLM?",
    "hypothesis": "The harder phase-2 scenarios separate the models on accuracy, not only on speed; the thinking model is much slower.",
    "variants": [
        {
            "id": "gemini-flash-lite",
            "label": "Gemini 3.5 Flash-Lite (cloud)",
            "base": "config/host.json",
            "set": {
                "llm.model": "gemini-3.5-flash-lite",
                "llm.temperature": 0.2,
                "toolDescriptions": {
                    "mode": "full"
                }
            },
            "paceMs": 4000
        },
        {
            "id": "qwen-instruct",
            "label": "Qwen3 4B Instruct (local)",
            "set": {}
        },
        {
            "id": "qwen-thinking",
            "label": "Qwen3 4B Thinking (local, 1 run)",
            "set": {
                "llm.model": "qwen3:4b"
            },
            "repeat": 1
        }
    ]
}
