# Copy to .env (in mcp-academic/ or the seminar-emt/ root) and fill in real values.
# NEVER commit it, sync it to Drive, or show it on a slide.

# Model 1 — Gemini (cloud). Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# (optional) pin a model; empty = newest stable Flash model
GEMINI_MODEL=

# Model 2 — Qwen via Ollama (runs locally) — set up in milestone M5
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
