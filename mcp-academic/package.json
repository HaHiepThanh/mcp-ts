{
    "name": "mcp-academic",
    "version": "0.1.0",
    "private": true,
    "description": "Seminar MCP.2502 — MCP TypeScript SDK v2: academic server + utility server + chat host with 2 LLMs",
    "type": "module",
    "engines": {
        "node": ">=20.12"
    },
    "scripts": {
        "doctor": "tsx scripts/doctor.ts",
        "typecheck": "tsc --noEmit",
        "sync": "bash ../sync-drive.sh",
        "data:sample": "tsx scripts/generate-sample-data.ts",
        "academic": "tsx src/server/academic/main.ts",
        "academic:http": "tsx src/server/academic/main.ts --http --port 3001",
        "examples": "tsx examples/run-all.ts",
        "utility": "tsx src/server/utility/main.ts",
        "utility:http": "tsx src/server/utility/main.ts --http --port 3002",
        "chat": "tsx src/host/main.ts",
        "check:vscode": "tsx scripts/check-vscode-config.ts",
        "results": "tsx scripts/build-results.ts"
    },
    "dependencies": {
        "@google/genai": "^2.23.0",
        "@modelcontextprotocol/client": "^2.0.0",
        "@modelcontextprotocol/node": "^2.0.0",
        "@modelcontextprotocol/server": "^2.0.0",
        "hono": "^4.11.4",
        "openai": "^7.20.0",
        "zod": "^4.2.0"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "tsx": "^4.23.0",
        "typescript": "^5.9.3"
    }
}
